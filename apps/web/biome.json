{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../.."
  },
  "files": {
    "includes": [
      "**",
      "!!.next",
      "!!node_modules",
      "!!next-env.d.ts",
      "!!lib/openapi.d.ts",
      "!!design/tokens.ts",
      "!!lib/ui-catalog.d.ts",
      "!!lib/ui-catalog-data.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "recommended",
      "next": "recommended",
      "test": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  }
}
