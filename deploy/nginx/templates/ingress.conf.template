# Rendered at container start by the image's envsubst entrypoint; 05-ingress.envsh derives
# the host names from DONOR_PUBLIC_ORIGIN and DONOR_STAFF_ORIGIN and checks INGRESS_MODE.
include /etc/nginx/ingress/${INGRESS_MODE}/real-ip.conf;

server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    return 444;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${INGRESS_PUBLIC_HOST} ${INGRESS_STAFF_HOST} ${INGRESS_NATIVE_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    http2 on;
    ssl_reject_handshake on;
    # Reached only when a known SNI name carries some other Host header.
    return 421;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${INGRESS_PUBLIC_HOST};
    include /etc/nginx/ingress/${INGRESS_MODE}/origin.conf;
    include /etc/nginx/ingress/limited.conf;

    location / {
        proxy_pass http://web;
    }

    # The back office lives on the staff host only; the web app and API also refuse it here.
    location ~* ^/(staff|api/donor/staff)(/|$) {
        include /etc/nginx/ingress/not-found.conf;
    }

    location ~ ^/api/donor/(login|signup|password/sign-in|claim|email-change/confirm|(passkeys|phone)/sign-in(/options)?|oidc/[^/]+/sign-in|partner/(sign-in|accept-invite))$ {
        limit_req zone=auth burst=20 nodelay;
        error_page 429 @auth_limited;
        proxy_pass http://web;
    }

    location ~ ^/api/donor/(checkouts|referrals/[^/]+|company/[^/]+|public/partner-apply|partner/applications)$ {
        limit_req zone=visitor burst=60 nodelay;
        proxy_pass http://web;
    }

    location = /api/donor/partner/logo {
        client_max_body_size 360000;
        proxy_pass http://web;
    }

    location = /api/donor/stripe/webhook {
        limit_except POST {
            deny all;
        }
        limit_req zone=stripe burst=500 nodelay;
        proxy_pass http://web;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${INGRESS_STAFF_HOST};
    include /etc/nginx/ingress/${INGRESS_MODE}/origin.conf;
    include /etc/nginx/ingress/limited.conf;
    include /etc/nginx/staff-access.conf;
    # The web app marks its responses too; hiding its copy leaves exactly one.
    proxy_hide_header X-Robots-Tag;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Only the back office and the assets it loads; donor pages and APIs stay on the public host.
    location / {
        include /etc/nginx/ingress/not-found.conf;
    }

    # Finished CSV exports stream from storage and abort mid-body on failure.
    location ^~ /api/donor/staff/exports/ {
        proxy_buffering off;
        proxy_pass http://web;
    }

    # Regular expressions match in order, so the general allowlist comes last.
    location ~ ^/api/donor/staff/(sign-in|activate)(/options)?$ {
        limit_req zone=auth burst=20 nodelay;
        error_page 429 @auth_limited;
        proxy_pass http://web;
    }

    location ~ ^/api/donor/staff/partners/[^/]+/logo$ {
        client_max_body_size 360000;
        proxy_pass http://web;
    }

    location = /api/donor/staff/founding-claims {
        client_max_body_size 5m;
        proxy_pass http://web;
    }

    location = /api/donor/staff/content/rules {
        client_max_body_size 10m;
        proxy_pass http://web;
    }

    # Source documents up to 10 MiB.
    location ~ ^/api/donor/staff/content/sources$ {
        client_max_body_size 10m;
        proxy_pass http://web;
    }

    location ~ ^/(|favicon\.ico|icon\.svg|robots\.txt|staff|staff/.*|_next/.*|api/donor/staff/.*)$ {
        proxy_pass http://web;
    }
}

upstream native_api {
    zone native_api 64k;
    server ${INGRESS_NATIVE_UPSTREAM} resolve;
    keepalive 32;
    keepalive_timeout 4s;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${INGRESS_NATIVE_HOST};
    include /etc/nginx/ingress/${INGRESS_MODE}/origin.conf;
    default_type application/json;
    set $native_enabled ${INGRESS_NATIVE_ENABLED};
    if ($native_enabled = 0) { return 404 '{"detail":"Not found"}'; }
    if ($native_allowed_methods = "") { return 404 '{"detail":"Not found"}'; }
    if ($native_request_valid = 0) { return 403 '{"detail":"Native requests must omit Origin and cookies"}'; }
    if ($native_operation_class = forbidden) { return 405 '{"detail":"Method not allowed"}'; }
    error_page 429 @native_limited;
    error_page 502 504 =503 @native_unavailable;
    error_page 413 @native_too_large;
    proxy_hide_header Cache-Control;
    proxy_hide_header X-Content-Type-Options;
    add_header Allow $native_method_allow always;
    limit_req zone=general burst=300 nodelay;
    limit_req zone=native_auth burst=20 nodelay;
    limit_req zone=native_visitor burst=60 nodelay;
    add_header Cache-Control "no-store" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://native_api;
    }
    location = /donor/partner/logo {
        client_max_body_size 360000;
        proxy_pass http://native_api;
    }
    location @native_unavailable {
        add_header_inherit merge;
        add_header Retry-After 1 always;
        return 503 '{"detail":"API temporarily unavailable"}';
    }
    location @native_too_large {
        return 413 '{"detail":"Request body is too large"}';
    }
    location @native_limited {
        add_header_inherit merge;
        add_header Retry-After $native_retry_after always;
        return 429 '{"detail":"Too many requests"}';
    }
}
